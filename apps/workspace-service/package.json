{
  "name": "@flowpilot/workspace-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint src test vitest.config.mjs --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "clean": "tsc --build tsconfig.build.json --clean"
  },
  "dependencies": {
    "@flowpilot/contracts": "workspace:*",
    "express": "5.2.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@types/supertest": "7.2.1",
    "supertest": "7.2.2"
  }
}
