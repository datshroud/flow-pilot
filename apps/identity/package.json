{
  "name": "@flowpilot/identity",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint src test vitest.config.mjs vitest.integration.config.mjs --max-warnings 0",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mjs",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "clean": "tsc --build tsconfig.build.json --clean",
    "generate": "prisma generate",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@flowpilot/contracts": "workspace:*",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@prisma/client-runtime-utils": "^7.9.0",
    "express": "5.2.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@types/supertest": "7.2.1",
    "prisma": "^7.9.0",
    "supertest": "7.2.2"
  }
}
