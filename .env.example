POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

API_GATEWAY_PORT=4000
IDENTITY_PORT=4101
TICKETS_PORT=4102
WORKER_PORT=4103
ML_PORT=4104

IDENTITY_DATABASE_URL=postgresql://identity:identity@localhost:5432/flowpilot_identity
TICKETS_DATABASE_URL=postgresql://tickets:tickets@localhost:5432/flowpilot_tickets
REDIS_URL=redis://localhost:6379

# The tickets service calls the ML service over HTTP (ADR-014). The timeout
# is short on purpose: ticket intake degrades to "not classified" rather than
# waiting on a slow model (ADR-017).
ML_BASE_URL=http://localhost:4104
ML_REQUEST_TIMEOUT_MS=800

# Model artifacts and training snapshots never enter Git (ADR-017).
ML_ARTIFACT_DIR=var/models
ML_SNAPSHOT_DIR=var/snapshots
ML_RANDOM_SEED=42
